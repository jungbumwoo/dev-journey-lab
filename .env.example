# Reproducibility matters: do not replace this with latest or a floating major tag.
REDIS_IMAGE=redis:8.8.1-trixie
CLIENT_IMAGE=redis-operations-client:local

# Compose project names isolate this lab from other local Redis containers.
SENTINEL_PROJECT=redis-sentinel-lab
CLUSTER_PROJECT=redis-cluster-lab

# Lab timings are intentionally short for a local machine.
SENTINEL_FAILOVER_TIMEOUT_SECONDS=45
CLUSTER_FAILOVER_TIMEOUT_SECONDS=45
